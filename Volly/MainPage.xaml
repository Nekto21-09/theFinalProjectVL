<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Volly.MainPage">

    <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
        <HorizontalStackLayout HeightRequest="185">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"/>
            <Label Text="Volly" HorizontalOptions="Center" VerticalOptions="Center"/>
        </HorizontalStackLayout>
        <Border BackgroundColor="Transparent"
                Stroke="#FBC02D"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 6"
                Padding="12,8"
                HorizontalOptions="Center"
                VerticalOptions="Center">

            <Label Text="VOLLEYBALL, EVOLVED"
                   TextColor="#333333"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Border>

        <Label Text="Own every"
           TextColor="#333333"
           FontSize="16"
           HorizontalTextAlignment="Center"
           VerticalTextAlignment="Center" />

        <Label Text="Moment"
            TextColor="#333333"
            FontSize="16"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />


        <Label Text="Train with purpose. Build smarter tactics. Become the player your team needs."
            TextColor="#333333"
            FontSize="16"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

        <Button
            x:Name="SignupBtn"
            Text="Get Started"
            Clicked="OnSignupClicked"
            HorizontalOptions="Fill" />

        <Button
            x:Name="LoginBtn"
            Text="Aready have an account?"
            Clicked="OnLoginClicked"
            HorizontalOptions="Fill" />
    </VerticalStackLayout>

</ContentPage>
