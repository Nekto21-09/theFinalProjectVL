<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Volly.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#080E20">

    <ScrollView>
        <Grid Padding="36,30,36,30"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="0">

            <!-- Back button -->
            <Border Grid.Row="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    HorizontalOptions="Start"
                    BackgroundColor="#111C32"
                    Stroke="#24334D"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
                <Label Text="‹"
                       FontSize="30"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       Margin="0,-4,0,0"/>
            </Border>

            <!-- Welcome text -->
            <VerticalStackLayout Grid.Row="1"
                                 Spacing="13"
                                 Margin="0,68,0,0">

                <Border BackgroundColor="#14213A"
                        Stroke="#263B5D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HorizontalOptions="Start"
                        Padding="9,5">
                    <Label Text="WELCOME BACK"
                           FontSize="9"
                           FontAttributes="Bold"
                           TextColor="#8DBEFF"
                           CharacterSpacing="0.7"/>
                </Border>

                <Label Text="Ready to play?"
                       FontSize="26"
                       TextColor="White"
                       CharacterSpacing="-0.6"/>

                <Label Text="Sign in to continue your volleyball journey."
                       FontSize="12"
                       TextColor="#A8B5CC"/>
            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout Grid.Row="2"
                                 Spacing="8"
                                 Margin="0,27,0,0">
                <Label Text="EMAIL OR USERNAME"
                       FontSize="9"
                       FontAttributes="Bold"
                       TextColor="#8DBEFF"
                       CharacterSpacing="0.7"/>

                <Border BackgroundColor="#111B2D"
                        Stroke="#26364F"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="44">
                    <Entry x:Name="EmailEntry"
                           Placeholder="alex@volt.app"
                           PlaceholderColor="#8290A8"
                           TextColor="White"
                           FontSize="13"
                           Keyboard="Email"
                           Margin="10,0"
                           VerticalOptions="Center"/>
                </Border>
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Grid.Row="3"
                                 Spacing="8"
                                 Margin="0,15,0,0">
                <Label Text="PASSWORD"
                       FontSize="9"
                       FontAttributes="Bold"
                       TextColor="#8DBEFF"
                       CharacterSpacing="0.7"/>

                <Border BackgroundColor="#111B2D"
                        Stroke="#26364F"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="44">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="PasswordEntry"
                               Grid.Column="0"
                               Placeholder="Password"
                               IsPassword="True"
                               PlaceholderColor="#8290A8"
                               TextColor="White"
                               FontSize="13"
                               Margin="10,0,0,0"
                               VerticalOptions="Center"/>

                        <Button x:Name="PasswordToggleButton"
                                Grid.Column="1"
                                Text="◉"
                                FontSize="16"
                                TextColor="#A8B5CC"
                                BackgroundColor="Transparent"
                                WidthRequest="42"
                                Padding="0"
                                Clicked="OnPasswordToggleClicked"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Forgot password -->
            <Label Grid.Row="4"
                   Text="Forgot password?"
                   FontSize="10"
                   TextColor="#8DBEFF"
                   HorizontalOptions="End"
                   Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                </Label.GestureRecognizers>
            </Label>

            <!-- Login button -->
            <Button Grid.Row="5"
                    Text="Log In"
                    HeightRequest="45"
                    Margin="0,21,0,0"
                    BackgroundColor="#72A8F2"
                    TextColor="#071226"
                    FontSize="12"
                    FontAttributes="Bold"
                    CornerRadius="11"
                    Clicked="OnLoginClicked"/>

            <!-- Create account -->
            <HorizontalStackLayout Grid.Row="6"
                                   HorizontalOptions="Center"
                                   Spacing="3"
                                   Margin="0,15,0,0">
                <Label Text="New to Volly?"
                       FontSize="10"
                       TextColor="#A8B5CC"/>

                <Label Text="Create account"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#8DBEFF">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateAccountTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>
